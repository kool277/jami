# Copy to .env (git-ignored) and fill in the passwords.

# Address clients use to reach JAMS (IP or DNS name), and the TLS mode:
# "internal" = Caddy's local CA; an e-mail address = Let's Encrypt
# (needs a public DNS name and port 443 reachable from the internet).
JAMS_HOST=192.168.1.92
JAMS_TLS=internal
JAMS_HTTPS_PORT=443

# JAMS admin account created by scripts/jams-setup.sh
JAMS_ADMIN_USER=admin
JAMS_ADMIN_PASSWORD=

# Test users created by scripts/jams-setup.sh (comma-separated)
JAMS_TEST_USERS=alice,bob,carol,dave,erin,frank,gina
JAMS_TEST_PASSWORD=

# coturn (host network; the host's coturn.service keeps 3478).
# Keep the realm "ring": JAMS does not push TURN.realm, so Jami clients
# authenticate with their default realm, which is "ring".
TURN_REALM=ring
TURN_USER=jami
TURN_PASSWORD=
TURN_PORT=3479
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Set when clients reach this host through NAT: public IP of the router
TURN_EXTERNAL_IP=

# Access from the internet (docs/SERVER-SETUP.md): the public name, the
# port of JAMS on it, and the compose files that turn it on, with Let's
# Encrypt certificates for PUBLIC_HOST. Left out, JAMS is on the LAN only.
#PUBLIC_HOST=jams.jaybi.uz
#JAMS_PUBLIC_PORT=9443
#COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml

# OpenDHT node: DHT port (UDP) and DHT proxy port (HTTP)
DHT_PORT=4222
DHT_PROXY_PORT=8000
DHT_BOOTSTRAP=bootstrap.jami.net

# Jami web client (service web): HTTP port on this host (127.0.0.1 only),
# HTTPS port on Caddy for other machines, and the password of its admin
# account (created by scripts/web-setup.sh)
WEB_PORT=8090
WEB_HTTPS_PORT=8443
JAMI_WEB_ADMIN_PASSWORD=
