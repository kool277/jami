# Copy to .env (git-ignored) and fill in the passwords.

# Address clients use to reach JAMS (IP or DNS name), and the TLS mode:
# "internal" = Caddy's local CA; an e-mail address = Let's Encrypt
# (needs a public DNS name and port 443 reachable from the internet).
JAMS_HOST=192.168.1.92
JAMS_TLS=internal
JAMS_HTTPS_PORT=443

# JAMS admin account created by scripts/jams-setup.sh
JAMS_ADMIN_USER=admin
JAMS_ADMIN_PASSWORD=

# Test users created by scripts/jams-setup.sh (comma-separated)
JAMS_TEST_USERS=alice,bob
JAMS_TEST_PASSWORD=

# coturn (host network; the host's coturn.service keeps 3478)
TURN_REALM=jami-server
TURN_USER=jami
TURN_PASSWORD=
TURN_PORT=3479
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# Set when clients reach this host through NAT: public IP of the router
TURN_EXTERNAL_IP=

# OpenDHT node: DHT port (UDP) and DHT proxy port (HTTP)
DHT_PORT=4222
DHT_PROXY_PORT=8000
DHT_BOOTSTRAP=bootstrap.jami.net
