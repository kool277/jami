{
  "name": "jami-web-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:build": "node scripts/build-material-symbols.mjs",
    "prebuild": "npm run icons:build",
    "prestart": "npm run icons:build",
    "prestorybook": "npm run icons:build",
    "start": "tsc-watch --build ../common --onSuccess \"vite --mode development\"",
    "start:prod": "vite preview --mode production",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test:unit": "vitest run",
    "build": "tsc --build && vite build --mode production",
    "clean": "rm -rf dist ../server/client/dist *.tsbuildinfo",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "extract-translations": "i18next"
  },
  "browserslist": {
    "production": [
      "Chrome >= 117",
      "Edge >= 121",
      "Firefox >= 121",
      "Safari >= 17",
      "iOS >= 17"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/ubuntu": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/lab": "^9.0.0-beta.8",
    "@mui/material": "^9.3.1",
    "@mui/stylis-plugin-rtl": "^9.3.0",
    "@popperjs/core": "^2.11.8",
    "@savoirfairelinux/jami-web-common": "1.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "axios": "^1.19.0",
    "check-password-strength": "^2.0.10",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "emoji-picker-react": "^4.19.1",
    "filesize": "^11.0.22",
    "framer-motion": "^12.43.0",
    "i18next": "^26.3.6",
    "link-preview-js": "4.0.3",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "mime": "^4.1.0",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.1",
    "react-dropzone": "^15.0.0",
    "react-emoji-render": "^2.0.1",
    "react-i18next": "^17.0.11",
    "react-intersection-observer": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "stylis": "https://registry.npmjs.org/stylis/-/stylis-4.2.0.tgz"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/compat": "^2.1.0",
    "@mui/types": "^9.3.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.4.0",
    "@types/react": "^19.2.18",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.2.4",
    "@types/react-transition-group": "^4.4.12",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "hermes-parser": "^0.36.1",
    "i18next-cli": "^1.69.0",
    "jsdom": "^29.1.1",
    "material-symbols": "^0.45.10",
    "rollup": "^4.62.4",
    "sass": "^1.102.0",
    "storybook": "^10.5.8",
    "subset-font": "^2.5.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zod-validation-error": "^4.0.2"
  }
}
