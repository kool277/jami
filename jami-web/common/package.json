{
  "name": "@savoirfairelinux/jami-web-common",
  "version": "1.1.0",
  "description": "Shared types and interfaces for jami-web (client, server, SDK).",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./src/enums/*": {
      "import": "./dist/enums/*.js",
      "types": "./dist/enums/*.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://git.jami.net/savoirfairelinux/jami-web.git",
    "directory": "common"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
