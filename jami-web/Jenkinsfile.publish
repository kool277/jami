// NPM publishing pipeline for jami-web:
//   @savoirfairelinux/jami-web-common  (shared types and interfaces)
//   @savoirfairelinux/jami-web         (server including the bundled web client)

pipeline {
    agent { label 'linux-builder' }

    options {
        ansiColor('xterm')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: true,
            description: 'Run npm pack without publishing (for verification).'
        )
    }

    environment {
        SCOPE = '@savoirfairelinux'
        COMMON_PKG = "${SCOPE}/jami-web-common"
        WEB_PKG = "${SCOPE}/jami-web"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'node:24-slim'
                    reuseNode true
                    args '-e HOME=/tmp'
                }
            }
            steps {
                sh 'npm ci'
                // The jami-web prepack step rebuilds the client and common
                // workspaces, but build them explicitly here so any failure
                // surfaces early and clearly.
                sh 'npm run build --workspace=@savoirfairelinux/jami-web-common'
                sh 'npm run build --workspace=client'
                sh 'npm run build --workspace=@savoirfairelinux/jami-web'
            }
        }

        stage('Publish @savoirfairelinux/jami-web-common') {
            when {
                changeset 'common/**'
            }
            agent {
                docker {
                    image 'node:24-slim'
                    reuseNode true
                    args '-e HOME=/tmp'
                }
            }
            steps {
                publishWorkspace('@savoirfairelinux/jami-web-common')
            }
        }

        stage('Publish @savoirfairelinux/jami-web') {
            agent {
                docker {
                    image 'node:24-slim'
                    reuseNode true
                    args '-e HOME=/tmp'
                }
            }
            steps {
                publishWorkspace('@savoirfairelinux/jami-web')
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}

/**
 * Publish (or pack, when DRY_RUN) a single npm workspace.
 */
void publishWorkspace(String workspace) {
    withCredentials([string(credentialsId: 'npm-token', variable: 'NPM_TOKEN')]) {
        writeFile file: '.npmrc', text: '//registry.npmjs.org/:_authToken=${NPM_TOKEN}\n'
        if (params.DRY_RUN) {
            sh "npm pack --dry-run --workspace=${workspace}"
        } else {
            sh "npm publish --access public --workspace=${workspace}"
        }
    }
}
