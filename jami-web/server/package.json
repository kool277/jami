{
  "name": "@savoirfairelinux/jami-web",
  "version": "0.2.1",
  "description": "Jami Web server and web client, packaged for npm.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "dist/index.js",
  "bin": {
    "jami-web": "dist/cli.js"
  },
  "files": [
    "dist",
    "client/dist",
    "available_languages.json",
    "openid-providers.json",
    "openapi.yaml",
    "locale"
  ],
  "scripts": {
    "start": "NODE_ENV=development tsc-watch --build --onSuccess \"node dist/index.js\"",
    "start:prod": "env NODE_ENV=production node dist/index.js",
    "build": "tsc --build && chmod +x dist/cli.js",
    "test:unit": "npx --yes tsx --experimental-test-module-mocks --test src/*.test.ts src/**/*.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepack": "cd .. && npm run build --workspace client && npm run clean --workspace @savoirfairelinux/jami-web && npm run build --workspace @savoirfairelinux/jami-web",
    "genkeys": "node dist/cli.js genkeys"
  },
  "dependencies": {
    "@savoirfairelinux/jami-core": "0.5.2",
    "@savoirfairelinux/jami-web-common": "*",
    "@simplewebauthn/server": "^13.3.2",
    "argon2": "^0.44.0",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "env-paths": "^3.0.0",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "7.5.0",
    "helmet": "^7.2.0",
    "jose": "^5.10.0",
    "link-preview-js": "5.0.0-beta.0",
    "linkifyjs": "^4.3.3",
    "loglevel": "^1.9.2",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "typedi": "^0.10.0",
    "vcard4-ts": "^0.4.1",
    "whatwg-url": "^14.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.4.0",
    "@types/whatwg-url": "^11.0.5",
    "@types/ws": "^8.18.1",
    "tsc-watch": "^6.3.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://git.jami.net/savoirfairelinux/jami-web.git",
    "directory": "server"
  },
  "publishConfig": {
    "access": "public"
  }
}
