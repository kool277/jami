        "entryValues": [
            "1",
            "2",
            "3",
            "4"
        ],
        "entries": [
            "{{position_entries_1}}",
            "{{position_entries_2}}",
            "{{position_entries_3}}",
            "{{position_entries_4}}"
        ]
    },
