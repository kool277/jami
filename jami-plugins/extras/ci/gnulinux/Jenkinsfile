// Requirements:
// - gerrit-trigger plugin
// - Docker plugin
// - ansicolor plugin

pipeline {
    agent {
        node {
            label 'jami-buildmachine-04.mtl.sfl'
        }
    }

    triggers {
        gerrit customUrl: '',
            gerritProjects: [
                [branches: [[compareType: 'PLAIN', pattern: 'master']],
                 compareType: 'PLAIN',
                 disableStrictForbiddenFileVerification: false,
                 pattern: 'jami-plugins']],
            triggerOnEvents: [
                commentAddedContains('!build'),
                patchsetCreated(excludeDrafts: true, excludeNoCodeChange: true,
                    excludeTrivialRebase: true)]
    }

    options {
        ansiColor('xterm')
    }

    parameters {
        string(name: 'GERRIT_REFSPEC',
                defaultValue: 'refs/heads/master',
                description: 'The Gerrit plugins refspec to fetch.')
        string(name: 'dockerfile',
                defaultValue: 'Dockerfile_ubuntu_24.04',
                description: 'Dockerfile in plugins/docker/ repository to use for the build')
        string(name: 'GERRIT_TOPIC',
                defaultValue: '',
                description: 'topic must match the plugins name if the pipeline is to build that plugins.')
        booleanParam(name: 'ARCHIVE',
                     defaultValue: false,
                     description: 'do not propagate the release artifacts to the download server.')
    }

    environment {
        jenkinsUID = sh(returnStdout: true, script: 'id -u jenkins').replaceAll("\n", '').trim()
        jenkinsGID = sh(returnStdout: true, script: 'id -g jenkins').replaceAll("\n", '').trim()
        jenkinsUser = '${jenkinsUID}:${jenkinsGID}'
        cpuCount = sh returnStdout: true, script: 'nproc || echo -n 4'
    }

    stages {
        stage('SCM Checkout') {
            steps {
                // Wipe workspace and fetch jami-plugins
                checkout changelog: true, poll: false,
                    scm: [$class: 'GitSCM',
                        branches: [[name: 'FETCH_HEAD']],
                        doGenerateSubmoduleConfigurations: false,
                        extensions: [
                            [$class: 'CloneOption', noTags: true, reference: '', shallow: true],
                            [$class: 'WipeWorkspace']],
                        submoduleCfg: [],
                        userRemoteConfigs: [[refspec: '${GERRIT_REFSPEC}', url: 'https://${JAMI_GERRIT_URL}/jami-plugins']]]
            }
        }

        stage('Init repository') {
            steps {
                script {
                    sh """
                        git rev-parse HEAD
                        git submodule update --init --recursive
                    """
                }
            }
        }

        stage('Building Docker Image') {
            steps {
                script {
                    docker.build('plugins-linux', "-f docker/${dockerfile} --no-cache .")
                }
            }
        }

        stage('Setup and Build Dependencies') {
            steps {
                script {
                    def jenkinsUID = sh(returnStdout: true, script: 'id -u jenkins').replaceAll("\n", '').trim()
                    def jenkinsGID = sh(returnStdout: true, script: 'id -g jenkins').replaceAll("\n", '').trim()
                    def jenkinsUser = jenkinsUID+':'+jenkinsGID
                    def cpuCount = sh returnStdout: true, script: 'nproc || echo -n 4'
                    docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                        container -> code:{
                            def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                            def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                            ansiColor('css') {
                                exec_cmd("""
                                    pwd
                                    cd ./jami/daemon/contrib
                                    mkdir native && cd native
                                    ../bootstrap
                                    make -j${cpuCount}
                                """)
                            }
                        }
                    }
                }
            }
        }

        stage('Setup Virtual Environment') {
            steps {
                script {
                    docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                        container -> code:{
                            def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                            def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                            ansiColor('css') {
                                exec_cmd("""
                                    cd jami
                                    python3 -m venv .venv
                                    ./.venv/bin/pip install --upgrade pip
                                    ./.venv/bin/pip install -r ./SDK/certificate_requirements.txt
                                    ./.venv/bin/pip install -r ./SDK/requirements.txt
                                """)
                            }
                        }
                    }
                }
            }
        }

        stage('Build GreenScreen') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                script {
                    if(env.GERRIT_TOPIC == "" || env.GERRIT_TOPIC == "GreenScreen") {
                        docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -v /var/cache/jami:/var/cache/jami:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                            container -> code:{
                                def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                                def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        touch ./daemon/contrib/x86_64-linux-gnu/lib/opencv4/3rdparty/libade.a
                                        PLATFORM_TYPE="LINUX" AUTHOR="SFL" DIVISION="Internal" ./.venv/bin/python3 build-plugin.py --projects="GreenScreen"
                                        #PLATFORM_TYPE="LINUX" PROCESSOR=NVIDIA ./.venv/bin/python3 build-plugin.py --projects="GreenScreen" - to build with gpu support
                                        ./.venv/bin/python3 ./SDK/certKey.py create --subject GreenScreen ./privatekeys/
                                        ./.venv/bin/python3 ./SDK/certKey.py --plugin sign --issuer ./privatekeys/certificate --path ./build/x86_64-linux-gnu/GreenScreen.jpl ./signed/GreenScreen
                                        """)
                                }
                            }
                        }
                        if (!fileExists("./build/x86_64-linux-gnu/GreenScreen.jpl")) {
                            error "GreenScreen build output not found"
                        }
                        if (!fileExists("./signed/GreenScreen.jpl")) {
                            error "Signed GreenScreen JPL not found"
                        }
                        archiveArtifacts 'signed/GreenScreen.jpl'
                    }
                }
                }
            }
        }

        stage('Build AudioFilter') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                script {
                    if(env.GERRIT_TOPIC == "" || env.GERRIT_TOPIC == "AudioFilter") {
                        docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                            container -> code:{
                                def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                                def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        PLATFORM_TYPE="LINUX" AUTHOR="SFL" DIVISION="Internal" ./.venv/bin/python3 build-plugin.py --projects="AudioFilter"
                                        ./.venv/bin/python3 ./SDK/certKey.py create --subject AudioFilter ./privatekeys/
                                        ./.venv/bin/python3 ./SDK/certKey.py --plugin sign --issuer ./privatekeys/certificate --path ./build/x86_64-linux-gnu/AudioFilter.jpl ./signed/AudioFilter
                                """)
                                }
                            }
                        }
                        if (!fileExists("./build/x86_64-linux-gnu/AudioFilter.jpl")) {
                            error "AudioFilter build output not found"
                        }
                        if (!fileExists("./signed/AudioFilter.jpl")) {
                            error "Signed AudioFilter JPL not found"
                        }
                        archiveArtifacts 'signed/AudioFilter.jpl'
                    }
                }
                }
            }
        }

        stage('Build AutoAnswer') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                script {
                    if(env.GERRIT_TOPIC == "" || env.GERRIT_TOPIC == "AutoAnswer") {
                        docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                            container -> code:{
                                def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                                def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        PLATFORM_TYPE="LINUX" AUTHOR="SFL" DIVISION="Internal" ./.venv/bin/python3 build-plugin.py --projects="AutoAnswer"
                                        ./.venv/bin/python3 ./SDK/certKey.py create --subject AutoAnswer ./privatekeys/
                                        ./.venv/bin/python3 ./SDK/certKey.py --plugin sign  --issuer ./privatekeys/certificate   --path ./build/x86_64-linux-gnu/AutoAnswer.jpl   ./signed/AutoAnswer
                                """)
                                }
                            }
                        }
                        if (!fileExists("./build/x86_64-linux-gnu/AutoAnswer.jpl")) {
                            error "AutoAnswer build output not found"
                        }
                        if (!fileExists("./signed/AutoAnswer.jpl")) {
                            error "Signed AutoAnswer JPL not found"
                        }
                        archiveArtifacts 'signed/AutoAnswer.jpl'
                    }
                }
                }
            }
        }

        stage('Build WaterMark') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                script {
                    if(env.GERRIT_TOPIC == "" || env.GERRIT_TOPIC == "WaterMark") {
                        docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                            container -> code:{
                                def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                                def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        PLATFORM_TYPE="LINUX" AUTHOR="SFL" DIVISION="Internal" ./.venv/bin/python3 build-plugin.py --projects="WaterMark"
                                        ./.venv/bin/python3 ./SDK/certKey.py create --subject WaterMark ./privatekeys/
                                        ./.venv/bin/python3 ./SDK/certKey.py --plugin sign  --issuer ./privatekeys/certificate   --path ./build/x86_64-linux-gnu/WaterMark.jpl   ./signed/WaterMark
                                """)
                                }
                            }
                        }
                        if (!fileExists("./build/x86_64-linux-gnu/WaterMark.jpl")) {
                            error "WaterMark build output not found"
                        }
                        if (!fileExists("./signed/WaterMark.jpl")) {
                            error "Signed WaterMark not found"
                        }
                        archiveArtifacts 'signed/WaterMark.jpl'
                    }
                }
                }
            }
        }

        stage('Build WhisperTranscript') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                script {
                    if(env.GERRIT_TOPIC == "" || env.GERRIT_TOPIC == "Whisper" || env.GERRIT_TOPIC == "WhisperTranscript") {
                        docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                            container -> code:{
                                def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                                def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        touch ./daemon/contrib/x86_64-linux-gnu/lib/opencv4/3rdparty/libade.a
                                        wget -P WhisperTranscript/data/assets/ https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny-q5_1.bin 
                                        wget -P WhisperTranscript/data/assets/ https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base-q5_1.bin
                                        PLATFORM_TYPE="LINUX" AUTHOR="SFL" DIVISION="Internal" ./.venv/bin/python3 build-plugin.py --projects="WhisperTranscript"
                                        ./.venv/bin/python3 ./SDK/certKey.py create --subject WhisperTranscript ./privatekeys/
                                        ./.venv/bin/python3 ./SDK/certKey.py --plugin sign  --issuer ./privatekeys/certificate   --path ./build/x86_64-linux-gnu/WhisperTranscript.jpl   ./signed/WhisperTranscript
                                """)
                                }
                            }
                        }
                        if (!fileExists("./build/x86_64-linux-gnu/WhisperTranscript.jpl")) {
                            error "WhisperTranscript build output not found"
                        }
                        if (!fileExists("./signed/WhisperTranscript.jpl")) {
                            error "Signed WhisperTranscript not found"
                        }
                        archiveArtifacts 'signed/WhisperTranscript.jpl'
                    }
                }
                }
            }
        }

        stage('Build TranslateMessages') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                script {
                    if(env.GERRIT_TOPIC == "" || env.GERRIT_TOPIC == "TranslateMessages") {
                        docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                            container -> code:{
                                def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                                def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        [ -d TranslateMessages ] || { echo "TranslateMessages not in this patchset, skipping"; exit 0; }
                                        python3 -m venv .venv-cuda     && .venv-cuda/bin/pip     install onnxruntime-gpu==1.24.4
                                        python3 -m venv .venv-migraphx && .venv-migraphx/bin/pip install onnxruntime-migraphx --extra-index-url https://repo.radeon.com/rocm/manylinux/rocm-rel-6.2/
                                        python3 -m venv .venv-cpu      && .venv-cpu/bin/pip      install onnxruntime==1.24.4
                                        ./.venv/bin/pip install -r ./TranslateMessages/data/models/requirements.txt
                                        cd TranslateMessages/data/models && ../../../.venv/bin/python3 download_model.py --model-type m2m100 --quantize && cd ../../..
                                        CUDA_ORT_DIR=\$(.venv-cuda/bin/python3 -c "import onnxruntime, os; print(os.path.dirname(onnxruntime.__file__))")
                                        MIGRAPHX_ORT_DIR=\$(.venv-migraphx/bin/python3 -c "import onnxruntime, os; print(os.path.dirname(onnxruntime.__file__))")
                                        CPU_ORT_DIR=\$(.venv-cpu/bin/python3 -c "import onnxruntime, os; print(os.path.dirname(onnxruntime.__file__))")
                                        PLATFORM_TYPE="LINUX" cmake -S TranslateMessages -B TranslateMessages/build-local -DJAMI_PLUGIN_TRANSLATION_MODEL=m2m100 -DORT_CUDA_PYDIR=\$CUDA_ORT_DIR -DORT_MIGRAPHX_PYDIR=\$MIGRAPHX_ORT_DIR -DORT_CPU_PYDIR=\$CPU_ORT_DIR
                                        cmake --build TranslateMessages/build-local -j${cpuCount}
                                        ./.venv/bin/python3 ./SDK/certKey.py create --subject TranslateMessages ./privatekeys/
                                        ./.venv/bin/python3 ./SDK/certKey.py --plugin sign --issuer ./privatekeys/certificate --path ./build/x86_64-linux-gnu/TranslateMessages.jpl ./signed/TranslateMessages
                                    """)
                                }
                            }
                        }
                        if (!fileExists("./build/x86_64-linux-gnu/TranslateMessages.jpl")) {
                            error "TranslateMessages build output not found"
                        }
                        if (!fileExists("./signed/TranslateMessages.jpl")) {
                            error "Signed TranslateMessages JPL not found"
                        }
                        archiveArtifacts 'signed/TranslateMessages.jpl'
                    }
                }
                }
            }
        }

        stage('Test Certificate') {
            steps {
                script {
                    docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                        container -> code:{
                            def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                            def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                            ansiColor('css') {
                                exec_cmd("""cd jami && PYTHONPATH="./SDK/" ./.venv/bin/python3 ./extras/tests/CertificateTester.py""")
                            }
                        }
                    }
                }
            }
        }

        stage('Test Plugin Certificate') {
            steps {
                script {
                    docker.image('plugins-linux').withRun('-t -u '+jenkinsUser+' -v '+pwd()+':/root/jami/:rw -w /root/ -e BATCH_MODE=1', '/bin/bash') {
                        container -> code:{
                            def base_cmd = 'docker exec -t '+container.id+" sh -c '"
                            def exec_cmd = { cmd -> sh base_cmd+cmd+"'" }

                            ansiColor('css') {
                                exec_cmd("""cd jami && PYTHONPATH="./SDK/" ./.venv/bin/python3 ./extras/tests/PluginCertificateTester.py""")
                            }
                        }
                    }
                }
            }
        }
    }
}
