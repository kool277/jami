                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        PLATFORM_TYPE="ANDROID" ANDROID_ABI="armeabi-v7a" ./.venv/bin/python3 build-plugin.py --projects="WaterMark" --distribution="android"
                                        PLATFORM_TYPE="ANDROID" ANDROID_ABI="arm64-v8a" ./.venv/bin/python3 build-plugin.py --projects="WaterMark" --distribution="android"
                                        PLATFORM_TYPE="ANDROID" ANDROID_ABI="x86_64" ./.venv/bin/python3 build-plugin.py --projects="WaterMark" --distribution="android"
