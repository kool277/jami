                                def exec_root_cmd = { cmd -> sh script:base_root_cmd+cmd+"'" }

                                ansiColor('css') {
                                    exec_cmd("""
                                        cd jami
                                        PLATFORM_TYPE="ANDROID" AUTHOR="SFL" DIVISION="Internal" ANDROID_ABI="arm64-v8a" ./.venv/bin/python3 build-plugin.py --projects="WhisperTranscript" --distribution="android"
                                """)
                                }
                            }
                        }
                        if (env.ARCHIVE == 'false') {
                            sshagent(credentials: [env.SSH_CREDENTIALS]) {
                                // def sshPrivateKey = '/var/lib/jenkins/.ssh/gplpriv'
