                                    rsync --verbose build/android/WhisperTranscript.jpl ${remoteHost}:${remoteBaseDir}/WhisperTranscript.jpl
                                """
                            }
                        } else {
                            archiveArtifacts 'build/android/WhisperTranscript.jpl'
                        }
