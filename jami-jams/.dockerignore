# VCS metadata
.git
.gitignore
.gitmodules
.gitreview

# Docker build files
Dockerfile
.dockerignore

# IDE and editor settings
.gradle
.idea
.vscode

# Documentation and CI files the image build does not need
README.md
extras

# Build output: always regenerated inside the image, so a stale local copy
# must never be layered on top of it.
**/node_modules
**/target
**/dependency-reduced-pom.xml
jams-react-client/build
jams-server/src/main/resources/webapp
jams
versions.json

# Local runtime state and credentials produced by running JAMS or its tests.
# These are developer-machine artifacts and must never be baked into an image.
**/*.crl
**/*.jks
**/*.p12
**/*.pem
**/*.log
config.json
oauth.*
testdb
tomcat.*